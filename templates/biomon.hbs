<section class="ncm-biomon-wrap">
  {{#each this.links}}
  <div class="ncm-bm-link" data-link-id="{{this.id}}">
    <header class="ncm-bm-head">
      <span class="ncm-kicker">// {{localize "NEONCOMBAT.Biomon.Link"}}</span>
      <b>{{this.name}}</b>
      <span class="ncm-bm-tools">
        {{#if ../gm}}
        <button type="button" data-action="renameLink" data-tooltip="NEONCOMBAT.Biomon.Rename"><i class="fa-solid fa-pen"></i></button>
        <button type="button" class="is-danger" data-action="removeLink" data-tooltip="NEONCOMBAT.Biomon.Remove"><i class="fa-solid fa-link-slash"></i></button>
        {{/if}}
      </span>
    </header>
    <ol class="ncm-bm-list">
      {{#each this.members}}
      <li class="ncm-bm-row st-{{this.state}}" data-actor-id="{{this.id}}" style="--beat: {{this.beat}}">
        <button type="button" class="ncm-bm-face" data-action="focusMember" data-tooltip="{{this.name}}"><img src="{{this.img}}" alt=""></button>
        <div class="ncm-bm-main">
          <div class="ncm-bm-top">
            <b>{{this.name}}</b>
            {{#if this.implant}}<span class="ncm-bm-chip" data-tooltip="{{this.implantHint}}"><i class="fa-solid fa-microchip"></i></span>{{/if}}
            <span class="ncm-bm-state"{{#unless this.signal}} data-tooltip="NEONCOMBAT.Biomon.NoSignalHint"{{/unless}}>{{this.label}}{{#if this.deathSave}} · DS +{{this.deathSave}}{{/if}}</span>
            {{#if this.spoofed}}<span class="ncm-bm-spoof" data-tooltip="NEONCOMBAT.Biomon.SpoofedHint">{{localize "NEONCOMBAT.Biomon.Spoofed"}}</span>{{/if}}
          </div>
          <div class="ncm-bm-trace">
            <svg viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true"><path class="ncm-bm-grid" d="M0 8H120M0 16H120M0 24H120"/><path class="ncm-bm-ecg" d="{{this.ecg}}"/></svg>
            <span class="ncm-bm-bpm">{{#if this.bpm}}{{this.bpm}}<small>BPM</small>{{else}}---{{/if}}</span>
          </div>
          <div class="ncm-bm-hp" style="--pct: {{this.pct}}%"><span class="ncm-bm-hp-fill"></span><span class="ncm-bm-hp-text">{{#if this.signal}}HP {{this.hp}}<small>/{{this.max}}</small>{{else}}HP --{{/if}}</span></div>
          {{#if icons.length}}
          <ul class="ncm-fx">{{#each this.icons}}<li class="cat-{{this.category}}"><img src="{{this.img}}" alt="{{this.name}}" data-tooltip="{{this.name}}"></li>{{/each}}</ul>
          {{/if}}
        </div>
        <div class="ncm-bm-side">
          {{#if this.canCall}}<button type="button" data-action="callMember" data-tooltip="NEONCOMBAT.Biomon.CallMember"><i class="fa-solid fa-phone-volume"></i></button>{{/if}}
          {{#if this.fullBiomon}}<button type="button" data-action="fullBiomon" data-tooltip="NEONCOMBAT.Biomon.Full"><i class="fa-solid fa-wave-square"></i></button>{{/if}}
          {{#if this.mine}}<button type="button" class="is-danger" data-action="leaveLink" data-tooltip="NEONCOMBAT.Biomon.Leave"><i class="fa-solid fa-link-slash"></i></button>{{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
  {{else}}
  <p class="ncm-empty">{{localize "NEONCOMBAT.Biomon.NoLinks"}}</p>
  {{/each}}

  {{#if unlinked.length}}
  <div class="ncm-bm-join" data-join>
    <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Biomon.JoinTitle"}}</h4>
    <p class="ncm-hint">{{localize "NEONCOMBAT.Biomon.JoinHint"}}{{#if this.needsImplant}} {{localize "NEONCOMBAT.Biomon.ImplantNeeded"}}{{/if}}</p>
    <div class="ncm-bm-join-row">
      <select name="actor">{{#each this.unlinked}}<option value="{{this.id}}" {{#unless this.ok}}disabled{{/unless}}>{{this.name}}{{#unless this.ok}} ({{localize "NEONCOMBAT.Biomon.NoImplant"}}){{/unless}}</option>{{/each}}</select>
      {{#if this.canLink}}{{#if joinable.length}}
      <select name="link">{{#each this.joinable}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select>
      <button type="button" class="ncm-cta" data-action="joinLink"><i class="fa-solid fa-link"></i> {{localize "NEONCOMBAT.Biomon.Join"}}</button>
      {{/if}}{{/if}}
    </div>
    {{#if this.canLink}}
    <div class="ncm-bm-join-row">
      <input type="text" name="name" placeholder="{{localize 'NEONCOMBAT.Biomon.DefaultName'}}">
      <button type="button" data-action="createLink"><i class="fa-solid fa-plus"></i> {{localize "NEONCOMBAT.Biomon.Create"}}</button>
    </div>
    {{/if}}
  </div>
  {{/if}}
</section>

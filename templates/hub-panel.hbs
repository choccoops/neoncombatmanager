{{#if (eq kind "search")}}
<section class="ncm-hub-sec">
  <span class="ncm-kicker">// {{localize "NEONCOMBAT.Hub.Results"}}</span>
  {{#if this.empty}}<p class="ncm-hint">{{localize "NEONCOMBAT.Hub.NoResults"}}</p>{{/if}}
  {{#if places.length}}<ul class="ncm-hub-list">{{#each this.places}}<li class="{{#if this.hidden}}is-hidden{{/if}}"><button type="button" data-hub="select" data-key="{{this.key}}"><span class="ncm-hub-num" style="--c:{{this.color}}">{{this.n}}</span> {{this.name}}{{#if this.hidden}} <i class="fa-solid fa-eye-slash"></i>{{/if}}</button></li>{{/each}}</ul>{{/if}}
  {{#if districts.length}}<ul class="ncm-hub-list">{{#each this.districts}}<li><button type="button" data-hub="select" data-key="{{this.key}}"><span class="ncm-hub-code">{{this.code}}</span> {{this.name}}</button></li>{{/each}}</ul>{{/if}}
  {{#if stations.length}}<ul class="ncm-hub-list">{{#each this.stations}}<li><button type="button" data-hub="select" data-key="{{this.key}}"><i class="fa-solid fa-train-subway"></i> {{this.name}}</button></li>{{/each}}</ul>{{/if}}
</section>

{{else if (eq kind "place")}}
<section class="ncm-hub-sec" style="--c:{{this.color}}">
  <button type="button" class="ncm-hub-back" data-hub="home"><i class="fa-solid fa-chevron-left"></i> {{localize "NEONCOMBAT.Hub.Back"}}</button>
  <span class="ncm-kicker">// {{this.cat}}{{#if this.n}} · #{{this.n}}{{/if}}{{#if this.custom}} · {{localize "NEONCOMBAT.Hub.YourPlace"}}{{/if}}</span>
  <h2>{{this.name}}</h2>
  {{#if this.gm}}{{#if this.hidden}}<p class="ncm-hub-hidden"><i class="fa-solid fa-eye-slash"></i> {{localize "NEONCOMBAT.Hub.HiddenNote"}}</p>{{/if}}{{/if}}
  {{#if this.img}}<img class="ncm-hub-art" src="{{this.img}}" alt="">{{/if}}
  <p class="ncm-hub-where">{{#if this.districtKey}}<button type="button" data-hub="select" data-key="{{this.districtKey}}">{{this.district}}</button>{{else}}{{this.district}}{{/if}}
    {{#each this.chips}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}
    {{#unless this.signal}}<span class="ncm-hub-chip is-dead"><i class="fa-solid fa-signal"></i> {{localize "NEONCOMBAT.Hub.NoSignal"}}</span>{{/unless}}</p>
  {{#if this.sc}}<p class="ncm-hub-sc"><b>SC {{this.sc}}</b>{{#if this.guard}} · {{this.guard}}{{/if}}</p>{{/if}}
  {{#if this.text}}<p class="ncm-hub-text">{{this.text}}</p>{{/if}}
  <div class="ncm-hub-btns"><button type="button" class="ncm-hub-dossier-btn" data-hub="dossier" data-key="{{this.key}}"><i class="fa-solid fa-folder-open"></i> {{localize "NEONCOMBAT.Hub.OpenDossier"}}</button>
    {{#if door.canGo}}{{#if door.travelers.length}}<select name="goActor">{{#each door.travelers}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select>{{/if}}
    <button type="button" class="ncm-hub-go" data-hub="goThere" data-key="{{this.key}}" data-tooltip="{{localize 'NEONCOMBAT.Hub.Door.GoHint' scene=door.sceneName}}"><i class="fa-solid fa-door-open"></i> {{localize "NEONCOMBAT.Hub.Door.Go"}}</button>{{/if}}
    {{#if door.why}}<button type="button" class="ncm-hub-go" disabled data-tooltip="{{door.why}}"><i class="fa-solid fa-door-closed"></i> {{localize "NEONCOMBAT.Hub.Door.Go"}}</button>{{/if}}
  </div>
  {{#if stations.length}}
  <h4 class="ncm-sub">// NCART</h4>
  <ul class="ncm-hub-list">{{#each this.stations}}<li><button type="button" data-hub="select" data-key="s:{{this.id}}"><i class="fa-solid fa-train-subway"></i> {{this.name}} <small>{{localize "NEONCOMBAT.Hub.WalkFor" time=walk}}</small> {{#each this.lines}}<span class="ncm-hub-dot" style="--c:{{this.color}}" data-tooltip="{{this.name}}"></span>{{/each}}</button></li>{{/each}}</ul>
  {{/if}}
  {{{this.actions}}}
  {{#if this.gm}}
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Hub.GMPlace"}}</h4>
  <div class="ncm-hub-btns">
    {{#if this.hidden}}
    <button type="button" class="ncm-hub-reveal" data-hub="reveal" data-key="{{this.key}}"><i class="fa-solid fa-eye"></i> {{localize "NEONCOMBAT.Hub.Reveal"}}</button>
    <button type="button" data-hub="revealQuiet" data-key="{{this.key}}" data-tooltip="{{localize 'NEONCOMBAT.Hub.RevealQuietHint'}}"><i class="fa-regular fa-eye"></i> {{localize "NEONCOMBAT.Hub.RevealQuiet"}}</button>
    {{else}}
    <button type="button" data-hub="hide" data-key="{{this.key}}"><i class="fa-solid fa-eye-slash"></i> {{localize "NEONCOMBAT.Hub.Hide"}}</button>
    {{/if}}
    <button type="button" data-hub="editPlace" data-key="{{this.key}}"><i class="fa-solid fa-pen"></i> {{localize "NEONCOMBAT.Hub.Edit"}}</button>
    <button type="button" class="{{#if this.moving}}on{{/if}}" data-hub="movePlace" data-key="{{this.key}}"><i class="fa-solid fa-up-down-left-right"></i> {{localize "NEONCOMBAT.Hub.Move"}}</button>
    {{#if this.edited}}<button type="button" data-hub="resetPlace" data-key="{{this.key}}" data-tooltip="{{localize 'NEONCOMBAT.Hub.ResetHint'}}"><i class="fa-solid fa-rotate-left"></i> {{localize "NEONCOMBAT.Hub.Reset"}}</button>{{/if}}
    {{#if this.custom}}<button type="button" class="is-danger" data-hub="deletePlace" data-key="{{this.key}}"><i class="fa-solid fa-trash"></i> {{localize "NEONCOMBAT.Hub.Delete"}}</button>{{/if}}
  </div>
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Hub.GMNotes"}}</h4>
  <textarea name="placeNote" data-key="{{this.key}}" rows="3" placeholder="{{localize 'NEONCOMBAT.Hub.NotePlaceholder'}}">{{this.note}}</textarea>
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Hub.Door.Title"}}</h4>
  <p class="ncm-hint">{{localize "NEONCOMBAT.Hub.Door.Hint"}}</p>
  <label class="ncm-hub-scene">{{localize "NEONCOMBAT.Hub.Scene"}}
    <select name="placeScene" data-key="{{this.key}}">{{#each this.scenes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></label>
  {{#if this.door}}
  <label class="ncm-hub-scene">{{localize "NEONCOMBAT.Hub.Door.Landing"}}
    <select name="placeTile" data-key="{{this.key}}">{{#each door.tiles}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{#if this.active}}◆ {{/if}}{{this.label}}</option>{{/each}}</select></label>
  {{#if door.tagger}}<label class="ncm-hub-scene">{{localize "NEONCOMBAT.Hub.Door.Tag"}} <input type="text" name="placeTag" data-key="{{this.key}}" value="{{door.tag}}" placeholder="{{localize 'NEONCOMBAT.Hub.Door.TagHint'}}"></label>{{/if}}
  {{#unless door.matt}}<p class="ncm-hint">{{localize "NEONCOMBAT.Hub.Door.NoMatt"}}</p>{{/unless}}
  <label class="ncm-hub-scene ncm-check"><input type="checkbox" name="placeOpen" data-key="{{this.key}}" {{#if door.open}}checked{{/if}}> {{localize "NEONCOMBAT.Hub.Door.Open"}}</label>
  {{/if}}
  {{#if this.scene}}<div class="ncm-hub-btns">
    <button type="button" data-hub="viewScene" data-scene="{{this.scene}}"><i class="fa-solid fa-eye"></i> {{localize "NEONCOMBAT.Hub.ViewScene"}}</button>
    <button type="button" data-hub="activateScene" data-scene="{{this.scene}}"><i class="fa-solid fa-bullseye"></i> {{localize "NEONCOMBAT.Hub.ActivateScene"}}</button></div>{{/if}}
  {{/if}}
</section>

{{else if (eq kind "district")}}
<section class="ncm-hub-sec" style="--c:{{chips.0.color}}">
  <button type="button" class="ncm-hub-back" data-hub="home"><i class="fa-solid fa-chevron-left"></i> {{localize "NEONCOMBAT.Hub.Back"}}</button>
  <span class="ncm-kicker">// {{#if this.code}}{{localize "NEONCOMBAT.Hub.District"}} {{this.code}} · {{this.boro}}{{else}}{{localize "NEONCOMBAT.Hub.Outside"}}{{/if}}</span>
  <h2>{{this.name}}</h2>
  <p class="ncm-hub-where">{{#each this.chips}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}{{#if this.zone}} <small>{{this.zone}}</small>{{/if}}
    {{#unless this.signal}}<span class="ncm-hub-chip is-dead"><i class="fa-solid fa-signal"></i> {{localize "NEONCOMBAT.Hub.NoSignal"}}</span>{{/unless}}</p>
  <dl class="ncm-hub-codes">
    <dt>{{localize "NEONCOMBAT.Hub.Security"}}</dt><dd><b>{{this.sc}}</b> {{this.provider}}{{#if this.intensity}} · {{this.intensity}}{{/if}}</dd>
    <dt>{{localize "NEONCOMBAT.Hub.Utility"}}</dt><dd><b>{{this.uc}}</b></dd>
    {{#if this.was}}<dt>{{localize "NEONCOMBAT.Hub.Was"}}</dt><dd>{{this.was}}</dd>{{/if}}
    {{#if this.ncart}}<dt>NCART</dt><dd>{{this.ncart}}</dd>{{/if}}
    {{#if this.turf}}<dt>{{localize "NEONCOMBAT.Hub.Turf"}}</dt><dd>{{this.turf}}</dd>{{/if}}
  </dl>
  {{#if this.dossier}}<blockquote class="ncm-hub-dossier"><span class="ncm-kicker">// NCZTA-70</span>{{this.dossier}}{{#if this.note}}<small>{{this.note}}</small>{{/if}}</blockquote>{{/if}}
  {{{this.actions}}}
  {{#if this.gm}}
  <div class="ncm-hub-btns">
    {{#if this.canAdd}}<button type="button" class="ncm-hub-reveal" data-hub="addPlace"><i class="fa-solid fa-map-pin"></i> {{localize "NEONCOMBAT.Hub.AddPlaceHere"}}</button>{{/if}}
    {{#if this.hiddenCount}}<button type="button" data-hub="revealHere"><i class="fa-solid fa-eye"></i> {{localize "NEONCOMBAT.Hub.RevealHere" count=hiddenCount}}</button>{{/if}}
    {{#if this.shownCount}}<button type="button" data-hub="hideHere"><i class="fa-solid fa-eye-slash"></i> {{localize "NEONCOMBAT.Hub.HideHere" count=shownCount}}</button>{{/if}}
  </div>
  {{/if}}
  {{#if places.length}}
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Hub.Places"}}</h4>
  <ul class="ncm-hub-list">{{#each this.places}}<li class="{{#if this.hidden}}is-hidden{{/if}}"><button type="button" data-hub="select" data-key="{{this.key}}"><span class="ncm-hub-num" style="--c:{{this.color}}">{{this.n}}</span> {{this.name}}{{#if this.hidden}} <i class="fa-solid fa-eye-slash"></i>{{/if}} <small>{{this.cat}}</small></button></li>{{/each}}</ul>
  {{else}}
  {{#unless this.gm}}{{#if this.code}}<p class="ncm-hint">{{localize "NEONCOMBAT.Hub.NothingKnown"}}</p>{{/if}}{{/unless}}
  {{/if}}
</section>

{{else if (eq kind "station")}}
<section class="ncm-hub-sec">
  <button type="button" class="ncm-hub-back" data-hub="home"><i class="fa-solid fa-chevron-left"></i> {{localize "NEONCOMBAT.Hub.Back"}}</button>
  <span class="ncm-kicker">// NCART {{#if this.statusText}}· {{this.statusText}}{{/if}}</span>
  <h2>{{this.name}}</h2>
  <p class="ncm-hub-where">{{#each this.lines}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.name}}</span>{{/each}}</p>
  <p class="ncm-hub-where">{{#if this.districtKey}}<button type="button" data-hub="select" data-key="{{this.districtKey}}">{{this.district}}</button>{{else}}{{this.district}}{{/if}} {{#each this.chips}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}</p>
  {{{this.actions}}}
  {{#if places.length}}
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Hub.NearStation"}}</h4>
  <ul class="ncm-hub-list">{{#each this.places}}<li><button type="button" data-hub="select" data-key="{{this.key}}"><span class="ncm-hub-num" style="--c:{{this.color}}">{{this.n}}</span> {{this.name}}</button></li>{{/each}}</ul>
  {{/if}}
</section>

{{else if (eq kind "pin")}}
<section class="ncm-hub-sec">
  <button type="button" class="ncm-hub-back" data-hub="home"><i class="fa-solid fa-chevron-left"></i> {{localize "NEONCOMBAT.Hub.Back"}}</button>
  <div class="ncm-hub-who"><img src="{{this.img}}" alt=""><div><span class="ncm-kicker">// {{localize "NEONCOMBAT.Hub.Character"}}</span><h2>{{this.name}}</h2></div></div>
  <p class="ncm-hub-where">{{#if this.districtKey}}<button type="button" data-hub="select" data-key="{{this.districtKey}}">{{this.district}}</button>{{else}}{{this.district}}{{/if}} {{#each this.chips}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}
    {{#if this.noSignal}}<span class="ncm-hub-chip is-dead"><i class="fa-solid fa-signal"></i> {{localize "NEONCOMBAT.Hub.NoSignal"}}</span>{{/if}}</p>
  <div class="ncm-hub-btns">
    {{#if this.canCall}}<button type="button" class="ncm-hub-holo" data-hub="call" data-actor="{{this.actorId}}"><i class="fa-solid fa-phone-volume"></i> {{localize "NEONCOMBAT.Hub.Holocall"}}</button>{{/if}}
    {{#if this.mine}}<button type="button" data-hub="unpin" data-actor="{{this.actorId}}"><i class="fa-solid fa-location-pin-lock"></i> {{localize "NEONCOMBAT.Hub.Unpin"}}</button>{{/if}}
  </div>
  {{{this.actions}}}
</section>

{{else if (eq kind "crew")}}
<section class="ncm-hub-sec">
  <button type="button" class="ncm-hub-back" data-hub="home"><i class="fa-solid fa-chevron-left"></i> {{localize "NEONCOMBAT.Hub.Back"}}</button>
  <span class="ncm-kicker">// {{localize "NEONCOMBAT.Hub.WeAreHere"}}</span>
  <h2>{{#if this.label}}{{this.label}}{{else}}{{this.district}}{{/if}}</h2>
  <p class="ncm-hub-where">{{this.district}} {{#each this.chips}}<span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}</p>
  {{#if this.gm}}<div class="ncm-hub-btns"><button type="button" data-hub="crewClear"><i class="fa-solid fa-xmark"></i> {{localize "NEONCOMBAT.Hub.CrewClear"}}</button></div>{{/if}}
  {{{this.actions}}}
</section>

{{else}}
<section class="ncm-hub-sec">
  <span class="ncm-kicker">// NCZTA-70 · {{localize "NEONCOMBAT.Hub.Ratings"}}</span>
  <h2>{{localize "NEONCOMBAT.Hub.HomeTitle"}}</h2>
  <p class="ncm-hint">{{localize "NEONCOMBAT.Hub.HomeHint"}}</p>
  {{#if this.discovery}}<p class="ncm-hub-disc"><i class="fa-solid fa-eye"></i> {{localize "NEONCOMBAT.Hub.DiscoveryCount" shown=discovery.shown total=discovery.total}}{{#if discovery.on}} <small>{{localize "NEONCOMBAT.Hub.DiscoveryOnHint"}}</small>{{/if}}</p>{{/if}}
  {{#if this.crew}}<p class="ncm-hub-crewline"><button type="button" data-hub="select" data-key="crew"><i class="fa-solid fa-diamond"></i> {{localize "NEONCOMBAT.Hub.WeAreHere"}}: {{#if crew.label}}{{crew.label}}, {{/if}}{{crew.district}}</button></p>{{/if}}
  {{#if mine.length}}
  <ul class="ncm-hub-list ncm-hub-mine">{{#each this.mine}}<li>{{#if this.pinned}}<button type="button" data-hub="select" data-key="pin:{{this.id}}">{{else}}<span>{{/if}}<img src="{{this.img}}" alt=""> {{this.name}} <small>{{this.where}}</small>{{#if this.pinned}}</button>{{else}}</span>{{/if}}</li>{{/each}}</ul>
  {{/if}}
  {{#each this.groups}}
  <div class="ncm-hub-rating" style="--c:{{this.color}}">
    <h4><i></i>{{this.label}}</h4>
    <p>{{this.text}}</p>
    <div>{{#each this.districts}}<button type="button" data-hub="select" data-key="{{this.key}}"><span class="ncm-hub-code">{{this.code}}</span> {{this.name}}</button>{{/each}}</div>
  </div>
  {{/each}}
  <h4 class="ncm-sub">// NCART 2070</h4>
  <ul class="ncm-hub-lines">{{#each this.lines}}<li style="--c:{{this.color}}"><i></i><b>{{this.id}} {{this.name}}</b> <small>{{#if this.state}}{{this.state}}{{else}}{{this.summary}}{{/if}}</small></li>{{/each}}</ul>
</section>
{{/if}}

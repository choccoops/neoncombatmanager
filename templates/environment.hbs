<section class="ncm-env">
  <div class="ncm-env-now">
    <span class="ncm-kicker">// {{localize "NEONCOMBAT.Environment.Now"}}{{#if this.calendarName}} · {{this.calendarName}}{{/if}}</span>
    <div class="ncm-env-weather">
      {{#each this.now}}<span class="ncm-chip" data-tooltip="{{this.hint}}"><img src="{{this.img}}" alt=""> {{this.name}}</span>{{else}}<span class="ncm-chip"><i class="fa-solid fa-sun"></i> {{localize "NEONCOMBAT.Weather.clear"}}</span>{{/each}}
      {{#if this.band}}<span class="ncm-chip"><i class="fa-solid fa-temperature-half"></i> {{this.band}}{{#if this.temp}} · {{this.temp}}{{/if}}</span>{{/if}}
    </div>
  </div>

  {{#if this.gm}}
  <div class="ncm-grid">
    <label>{{localize "NEONCOMBAT.Settings.weatherSource.name"}}
      <select name="source">{{#each this.sources}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </label>
    {{#if calendars.length}}
    <label>{{localize "NEONCOMBAT.Environment.Calendar"}}
      <select name="calendar">{{#each this.calendars}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </label>
    {{else if hub}}
    <p class="ncm-hint">{{localize "NEONCOMBAT.Environment.NoCalendar"}}</p>
    {{else}}
    <p class="ncm-hint">{{localize "NEONCOMBAT.Environment.NoHub"}}</p>
    {{/if}}
    {{#if this.scene}}
    <label>{{localize "NEONCOMBAT.SceneWeather.Label"}} ({{scene.name}})
      <select name="sceneMode">{{#each this.sceneModes}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </label>
    {{/if}}
  </div>
  {{#if this.manual}}
  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Environment.Manual"}}</h4>
  <div class="ncm-grid">
    <label>{{localize "NEONCOMBAT.Environment.Sky"}} <select name="cond">{{#each this.sky}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
    <label>{{localize "NEONCOMBAT.Environment.Strange"}} <select name="strange">{{#each this.strange}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
    <label>{{localize "NEONCOMBAT.Environment.Temperature"}} <select name="band">{{#each this.bands}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
  </div>
  {{/if}}
  {{/if}}

  <h4 class="ncm-sub">// {{localize "NEONCOMBAT.Environment.Characters"}}
    {{#if this.scene}}<span class="ncm-ref">{{localize "NEONCOMBAT.Environment.SceneLight" darkness=scene.darkness}}{{#if scene.global}} · {{localize "NEONCOMBAT.Environment.Global"}}{{/if}}</span>{{/if}}
    {{#if this.gm}}<button type="button" class="ncm-mini" data-action="refreshEnv"><i class="fa-solid fa-rotate"></i> {{localize "NEONCOMBAT.Environment.Refresh"}}</button>{{/if}}
  </h4>
  <ol class="ncm-env-rows">
    {{#each this.rows}}
    <li class="lvl-{{this.level}}">
      <img src="{{this.img}}" alt="">
      <b>{{this.name}}</b>
      <span class="ncm-tag">{{#if this.outdoors}}{{localize "NEONCOMBAT.Environment.Outdoors"}}{{else}}{{localize "NEONCOMBAT.Environment.Sheltered"}}{{/if}}</span>
      <span class="ncm-tag lvl">{{this.levelLabel}}</span>
      <span class="ncm-tag sight" data-tooltip="NEONCOMBAT.Environment.SightHint">{{this.sightLabel}}</span>
      {{#if this.vision}}<span class="ncm-tag is-custom" data-tooltip="NEONCOMBAT.Environment.VisionHint"><i class="fa-solid fa-eye"></i> LL/IR/UV</span>{{/if}}
      <span class="ncm-env-fx">{{#each this.conditions}}<img src="{{this.img}}" alt="{{this.name}}" data-tooltip="{{this.name}}">{{/each}}</span>
    </li>
    {{else}}
    <li class="ncm-empty">{{localize "NEONCOMBAT.Environment.NoOne"}}</li>
    {{/each}}
  </ol>
</section>

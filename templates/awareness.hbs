<section class="ncm-ca-wrap">
  <header class="ncm-stakes-head">
    {{#if this.actor}}<img src="{{actor.img}}" alt="">{{/if}}
    <div>
      <span class="ncm-kicker">// {{localize "NEONCOMBAT.Awareness.Kicker"}}</span>
      <label class="ncm-stakes-who">{{localize "NEONCOMBAT.Awareness.Who"}}
        <select name="actor">{{#each this.choices}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select>
      </label>
    </div>
    {{#if this.actor}}
    <div class="ncm-stakes-luck{{#if this.over}} is-over{{/if}}" data-tooltip="NEONCOMBAT.Awareness.LeftHint">
      <b>{{this.left}}</b><small>/{{this.rank}}</small>
      <span>{{localize "NEONCOMBAT.Awareness.Left"}}</span>
    </div>
    {{/if}}
  </header>

  {{#if this.actor}}
  <div class="ncm-ca-pips" aria-hidden="true">{{#each this.pips}}<span class="{{#if this.on}}on{{/if}}"></span>{{/each}}</div>
  <p class="ncm-ca-mode mode-{{this.mode}}"><i class="fa-solid {{#if (eq mode 'action')}}fa-hand-fist{{else if (eq mode 'wait')}}fa-hourglass-half{{else if (eq mode 'gm')}}fa-user-shield{{else}}fa-circle-check{{/if}}"></i> {{this.modeText}}{{#if this.spent}} <em>· {{localize "NEONCOMBAT.Awareness.SpentThisRound"}}</em>{{/if}}</p>

  <ol class="ncm-ca-rows">
    {{#each this.rows}}
    <li class="ncm-ca-row{{#if this.changed}} is-changed{{/if}}{{#if this.wasted}} is-wasted{{/if}}" data-key="{{this.key}}">
      <i class="{{this.icon}}"></i>
      <div class="ncm-ca-name">
        <b>{{this.name}}</b>
        <small data-tooltip="{{this.hint}}">{{this.effect}}{{#if this.wasted}} · {{localize "NEONCOMBAT.Awareness.Wasted"}}{{/if}}</small>
      </div>
      <div class="ncm-ca-step">
        <button type="button" data-action="stepDown" {{#unless this.canDown}}disabled{{/unless}} aria-label="−"><i class="fa-solid fa-minus"></i></button>
        <output>{{this.points}}</output>
        <button type="button" data-action="stepUp" {{#unless this.canUp}}disabled{{/unless}} aria-label="+" data-tooltip="{{localize 'NEONCOMBAT.Awareness.StepHint' step=step}}"><i class="fa-solid fa-plus"></i></button>
      </div>
    </li>
    {{/each}}
  </ol>

  <div class="ncm-stakes-actions">
    <button type="button" class="ncm-cta" data-action="assign" {{#unless this.canAssign}}disabled{{/unless}}><i class="fa-solid fa-check"></i> {{this.assignLabel}}</button>
    <button type="button" data-action="revert" {{#unless this.changed}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> {{localize "NEONCOMBAT.Awareness.Revert"}}</button>
    <button type="button" data-action="clearAll"><i class="fa-solid fa-eraser"></i> {{localize "NEONCOMBAT.Awareness.Clear"}}</button>
  </div>
  {{else}}
  <p class="ncm-empty">{{localize "NEONCOMBAT.Awareness.NoSolo"}}</p>
  {{/if}}
</section>

<div class="ncm-dossier" style="--c:{{this.color}}" role="dialog" aria-label="{{this.name}}">
  <div class="nd-frame">
    <div class="nd-art">
      {{#if this.img}}<img src="{{this.img}}" alt="">{{else}}<div class="nd-sigil"><b>{{this.mark}}</b><span>{{this.cat}}</span></div>{{/if}}
      <span class="nd-scan" aria-hidden="true"></span>
      <span class="nd-tag">{{#if this.n}}NC-70 · #{{this.n}}{{else}}NC-70 · {{localize "NEONCOMBAT.Hub.YourPlace"}}{{/if}}</span>
    </div>
    <div class="nd-body">
      <span class="nd-kicker">// {{localize "NEONCOMBAT.Hub.Dossier"}} · <span class="nd-blink">{{localize "NEONCOMBAT.Hub.DossierLive"}}</span></span>
      <h1 data-text="{{this.name}}">{{this.name}}</h1>
      <p class="nd-where"><span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.cat}}</span> <span>{{this.district}}</span>{{#each this.chips}} <span class="ncm-hub-chip" style="--c:{{this.color}}">{{this.label}}</span>{{/each}}</p>
      {{#if this.sc}}<p class="nd-sc"><b>SC {{this.sc}}</b>{{#if this.guard}} · {{this.guard}}{{/if}}</p>{{/if}}
      <p class="nd-text" data-text="{{this.text}}"></p>
      {{#if stations.length}}<p class="nd-ncart"><i class="fa-solid fa-train-subway"></i> {{#each this.stations}}{{this.name}} <small>({{this.walk}})</small>{{#unless @last}} · {{/unless}}{{/each}}</p>{{/if}}
      <footer>
        {{#if this.canGo}}<button type="button" class="nd-go" data-hub="goThere" data-key="{{this.key}}"><i class="fa-solid fa-door-open"></i> {{localize "NEONCOMBAT.Hub.Door.Go"}}</button>{{/if}}
        <button type="button" data-hub="dossierMap"><i class="fa-solid fa-location-crosshairs"></i> {{localize "NEONCOMBAT.Hub.OnTheMap"}}</button>
        <button type="button" data-hub="dossierClose"><i class="fa-solid fa-xmark"></i> {{localize "NEONCOMBAT.Hub.Close"}}</button>
      </footer>
    </div>
  </div>
</div>

<section class="ncm-triggers-wrap">
  <p class="ncm-hint">{{localize "NEONCOMBAT.Triggers.Intro"}}</p>
  <table class="ncm-table">
    <thead>
      <tr>
        <th>{{localize "NEONCOMBAT.Triggers.Col.enabled"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.label"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.path"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.test"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.then"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.types"}}</th>
        <th>{{localize "NEONCOMBAT.Triggers.Col.revert"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each this.rows}}
      <tr data-trigger data-index="{{this.index}}" data-id="{{this.id}}">
        <td><input type="checkbox" name="enabled" {{#unless this.disabled}}checked{{/unless}}></td>
        <td><input type="text" name="label" value="{{this.label}}"></td>
        <td><input type="text" name="path" value="{{this.path}}"></td>
        <td class="ncm-test">
          <select name="op">{{#each this.ops}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <input type="text" name="value" value="{{this.value}}">
        </td>
        <td class="ncm-test">
          <select name="action">{{#each this.actions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <select name="condition">{{#each this.conditions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        </td>
        <td><input type="text" name="types" value="{{this.types}}" placeholder="character, mook"></td>
        <td><input type="checkbox" name="revert" {{#if this.revert}}checked{{/if}}></td>
        <td><button type="button" class="is-danger" data-action="removeTrigger"><i class="fa-solid fa-xmark"></i></button></td>
      </tr>
      {{else}}
      <tr><td colspan="8" class="ncm-empty">{{localize "NEONCOMBAT.Triggers.None"}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  <footer class="ncm-foot">
    <button type="button" data-action="addTrigger"><i class="fa-solid fa-plus"></i> {{localize "NEONCOMBAT.Triggers.Add"}}</button>
    <button type="button" class="ncm-cta" data-action="saveTriggers"><i class="fa-solid fa-floppy-disk"></i> {{localize "NEONCOMBAT.Common.Save"}}</button>
  </footer>
</section>

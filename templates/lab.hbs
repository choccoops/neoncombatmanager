<section class="ncm-lab-wrap">
  <header class="ncm-lab-head">
    <div>
      <span class="ncm-kicker">// {{localize "NEONCOMBAT.Lab.Kicker"}}</span>
      <h2>{{localize "NEONCOMBAT.Lab.Title"}}</h2>
      <p class="ncm-hint">{{localize "NEONCOMBAT.Lab.Intro"}}</p>
    </div>
    {{#if this.gm}}
    <div class="ncm-lab-tools">
      <button type="button" class="ncm-cta" data-action="create"><i class="fa-solid fa-plus"></i> {{localize "NEONCOMBAT.Lab.New"}}</button>
      <button type="button" data-action="openTriggers"><i class="fa-solid fa-bolt"></i> {{localize "NEONCOMBAT.Triggers.Title"}}</button>
      <button type="button" data-action="exportJson"><i class="fa-solid fa-file-export"></i> {{localize "NEONCOMBAT.Lab.Export"}}</button>
      <button type="button" data-action="importJson"><i class="fa-solid fa-file-import"></i> {{localize "NEONCOMBAT.Lab.Import"}}</button>
      {{#if this.cltPending}}<button type="button" data-action="importClt"><i class="fa-solid fa-right-left"></i> {{localize "NEONCOMBAT.Lab.ImportClt"}}</button>{{/if}}
    </div>
    {{/if}}
  </header>
  {{#if this.cltActive}}<p class="ncm-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "NEONCOMBAT.Lab.CltActive"}}</p>{{/if}}
  {{#if this.shim}}<p class="ncm-hint"><i class="fa-solid fa-plug"></i> {{localize "NEONCOMBAT.Lab.Shim"}}</p>{{/if}}
  <nav class="ncm-lab-views">
    {{#each this.views}}<button type="button" class="{{#if this.active}}on{{/if}}" data-action="view" data-view="{{this.id}}">{{this.label}} <small>{{this.count}}</small></button>{{/each}}
    <input type="search" name="search" value="{{this.search}}" placeholder="{{localize 'NEONCOMBAT.Lab.Search'}}">
  </nav>
  <ol class="ncm-lab-list">
    {{#each this.list}}
    <li class="ncm-lab-row{{#if this.disabled}} is-disabled{{/if}}" data-id="{{this.id}}">
      <button type="button" class="ncm-lab-icon" data-action="applyCondition" data-tooltip="NEONCOMBAT.Lab.ApplyHint"><img src="{{this.img}}" alt=""></button>
      <div class="ncm-lab-main">
        <div class="ncm-lab-name"><b>{{this.name}}</b> <span class="ncm-tag">{{this.category}}</span>{{#if this.override}} <span class="ncm-tag is-edit">{{localize "NEONCOMBAT.Lab.Edited"}}</span>{{/if}}{{#if this.custom}} <span class="ncm-tag is-custom">{{localize "NEONCOMBAT.Lab.Custom"}}</span>{{/if}}{{#if this.module}} <span class="ncm-tag">{{localize "NEONCOMBAT.Lab.FromModule"}}</span>{{/if}}{{#if this.page}} <span class="ncm-ref">{{this.page}}</span>{{/if}}</div>
        {{#if this.hint}}<p>{{this.hint}}</p>{{/if}}
        {{#if this.summary}}<p class="ncm-lab-mech">{{this.summary}}</p>{{/if}}
      </div>
      {{#if ../gm}}
      <div class="ncm-lab-actions">
        <button type="button" data-action="toggleHud" data-tooltip="{{#if this.disabled}}NEONCOMBAT.Lab.Enable{{else}}NEONCOMBAT.Lab.Disable{{/if}}"><i class="fa-solid {{#if this.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button>
        <button type="button" data-action="edit" data-tooltip="NEONCOMBAT.Lab.Edit"><i class="fa-solid fa-pen"></i></button>
        {{#if this.override}}<button type="button" data-action="reset" data-tooltip="NEONCOMBAT.Lab.Reset"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}
        {{#if this.custom}}<button type="button" class="is-danger" data-action="deleteCustom" data-tooltip="NEONCOMBAT.Lab.Delete"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </div>
      {{/if}}
    </li>
    {{else}}
    <li class="ncm-empty">{{localize "NEONCOMBAT.Lab.None"}}</li>
    {{/each}}
  </ol>
</section>

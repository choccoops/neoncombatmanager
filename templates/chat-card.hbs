<div class="neon-combat-chat ncm-chat tone-{{this.tone}}">
  <header>
    {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}
    <div>
      {{#if this.kicker}}<span class="ncm-kicker">// {{{this.kicker}}}</span>{{/if}}
      <h3>{{{this.title}}}</h3>
    </div>
  </header>
  {{#if this.body}}<div class="ncm-chat-body">{{{this.body}}}</div>{{/if}}
  {{#if buttons.length}}
  <footer>
    {{#each this.buttons}}
    <button type="button" data-ncm-action="{{this.action}}" {{{this.attrs}}}{{#if this.gm}} data-gm="true"{{/if}}{{#if this.owner}} data-owner="true"{{/if}}>{{#if this.icon}}<i class="{{this.icon}}"></i> {{/if}}{{{this.label}}}</button>
    {{/each}}
  </footer>
  {{/if}}
</div>

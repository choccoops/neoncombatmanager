<div class="ncm-hands-body">
  {{#if this.none}}
  <p class="ncm-hint">{{localize "NEONCOMBAT.Hands.NoActor"}}</p>
  {{else}}
  <header class="ncm-hands-head">
    <img src="{{this.img}}" alt="">
    <div>
      <b>{{this.name}}</b>
      <small>{{localize "NEONCOMBAT.Hands.Free" free=free total=total}}</small>
    </div>
  </header>

  <ul class="ncm-hands-slots">
    {{#each this.hands}}
    <li class="{{#if this.lost}}is-lost{{else if item}}is-full{{/if}}" data-tooltip="{{this.label}}">
      <i class="fa-solid {{#if this.lost}}fa-ban{{else}}fa-hand{{/if}}"></i>
      <span>{{this.label}}</span>
      <small>{{#if this.lost}}{{localize "NEONCOMBAT.Hands.Lost"}}{{else if item}}{{item.name}}{{else}}{{localize "NEONCOMBAT.Hands.Empty"}}{{/if}}</small>
    </li>
    {{/each}}
  </ul>

  <span class="ncm-kicker">// {{localize "NEONCOMBAT.Hands.Held"}}</span>
  {{#each this.held}}
  <div class="ncm-hands-row{{#if this.over}} is-alert{{/if}}">
    <img src="{{this.img}}" alt="">
    <div class="ncm-hands-name"><b>{{this.name}}</b><small>{{this.where}}</small></div>
    <button type="button" data-action="freeHand" data-item="{{this.id}}" data-tooltip="NEONCOMBAT.Hands.FreeHint"><i class="fa-solid fa-hand-holding"></i> {{localize "NEONCOMBAT.Hands.FreeIt"}}</button>
    <button type="button" data-action="dropItem" data-item="{{this.id}}" data-tooltip="NEONCOMBAT.Hands.DropHint"><i class="fa-solid fa-arrow-down"></i> {{localize "NEONCOMBAT.Hands.Drop"}}</button>
  </div>
  {{else}}
  <p class="ncm-hint">{{localize "NEONCOMBAT.Hands.NothingHeld"}}</p>
  {{/each}}

  <span class="ncm-kicker">// {{localize "NEONCOMBAT.Hands.Carried"}}</span>
  {{#each this.carried}}
  <div class="ncm-hands-row{{#unless this.fits}} is-off{{/unless}}">
    <img src="{{this.img}}" alt="">
    <div class="ncm-hands-name"><b>{{this.name}}</b><small>{{localize "NEONCOMBAT.Hands.Needs" n=need}}</small></div>
    <div class="ncm-hands-put">
      {{#each this.hands}}
      <button type="button" data-action="equipHand" data-item="{{../id}}" data-hand="{{this.id}}" data-tooltip="{{this.label}}" aria-label="{{this.label}}"><i class="fa-solid fa-hand-fist"></i> {{this.short}}</button>
      {{/each}}
    </div>
  </div>
  {{else}}
  <p class="ncm-hint">{{localize "NEONCOMBAT.Hands.NothingCarried"}}</p>
  {{/each}}
  {{/if}}
</div>
